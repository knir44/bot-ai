# Copy to .env and fill in GEMINI_API_KEY (free key: https://aistudio.google.com/apikey)

# --- Gemini ---------------------------------------------------------------
GEMINI_API_KEY=
# Models are configurable because Google retires/renames them regularly.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-2.5-flash
# Embedding size. gemini-embedding-001 natively gives 3072; it supports shrinking (Matryoshka).
# 768 = 4x less storage than 3072 with only a small quality loss. If you change it, recreate the ES index.
EMBEDDING_DIMENSIONS=768

# --- Postgres / pgAdmin -----------------------------------------------------
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind_pw
POSTGRES_DB=documind
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# --- Backend security ---------------------------------------------------------
# Used to sign session tokens (HMAC). Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_MB=10

# --- RAG knobs (all explained in docs/) ------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVE_K=20          # candidates fetched by EACH retriever (BM25 and vector)
TOP_K=5                # chunks finally sent to the LLM
RRF_K=60               # RRF smoothing constant (60 is the value from the original paper)
REWRITE_FOLLOWUPS=true # turn "when did it launch?" into a standalone question using chat history
